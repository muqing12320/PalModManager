<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PalModManager.WinUI.Views.ModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid RowDefinitions="Auto,*">
        <InfoBar
            x:Name="PageInfoBar"
            Grid.Row="0"
            IsOpen="False"
            IsClosable="True"
            Margin="0,0,0,8" />

        <Grid x:Name="LayoutGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Mod list -->
            <Border Grid.Column="0" Margin="12,0,0,0" Padding="20" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
            <Grid RowDefinitions="Auto,*">
                <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock x:Name="ModListHeaderText" Grid.Column="0" Text="Mod 列表" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock
                            Grid.Column="1"
                            Text="{x:Bind ViewModel.StatsText, Mode=OneWay}"
                            FontSize="12"
                            Opacity="0.7"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,4" />
                    </Grid>
                    <AutoSuggestBox x:Name="SearchBox" PlaceholderText="搜索 Mod..." QuerySubmitted="SearchBox_QuerySubmitted" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <ComboBox x:Name="TypeFilter" PlaceholderText="类型" Width="140" SelectionChanged="Filter_SelectionChanged">
                            <x:String>All</x:String>
                            <x:String>UE4SS_LUA</x:String>
                            <x:String>PAK</x:String>
                            <x:String>PALSCHEMA</x:String>
                            <x:String>LOGIC</x:String>
                        </ComboBox>
                        <ComboBox x:Name="StatusFilter" PlaceholderText="状态" Width="140" SelectionChanged="Filter_SelectionChanged">
                            <x:String>All</x:String>
                            <x:String>已启用</x:String>
                            <x:String>已禁用</x:String>
                            <x:String>冲突</x:String>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="ImportButton" Content="导入" Click="ImportButton_Click" />
                        <Button x:Name="ExportButton" Content="导出" Click="ExportButton_Click" />
                        <Button x:Name="ScanButton" Content="扫描合集" Click="ScanButton_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="RefreshButton" Content="刷新" Click="RefreshButton_Click" />
                        <Button x:Name="EnableAllButton" Content="全部启用" Click="EnableAllButton_Click" />
                        <Button x:Name="DisableAllButton" Content="全部禁用" Click="DisableAllButton_Click" />
                        <Button x:Name="ProfileButton" Content="方案" Click="ProfileButton_Click" />
                        <Button x:Name="RepairButton" Content="修复文件结构" Click="RepairButton_Click" />
                        <Button x:Name="LaunchButton" Content="启动游戏" Style="{StaticResource AccentButtonStyle}" Click="LaunchButton_Click" />
                    </StackPanel>
                </StackPanel>

                <ListView
                    Grid.Row="1"
                    x:Name="ModsListView"
                    ItemsSource="{x:Bind ViewModel.Mods, Mode=OneWay}"
                    SelectionChanged="ModsListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,12" ColumnDefinitions="Auto,*,Auto">
                                <CheckBox
                                    Grid.Column="0"
                                    MinWidth="0"
                                    Margin="0,0,0,0"
                                    IsChecked="{Binding Status, Converter={StaticResource ModStatusToBoolConverter}, Mode=OneWay}"
                                    Click="EnableCheckBox_Click" />
                                <StackPanel Grid.Column="1" Margin="0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}" Opacity="0.7" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding ModType}"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Opacity="0.7" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
            </Border>

            <Border
                x:Name="SplitterHandle"
                Grid.Column="1"
                Width="12"
                Background="Transparent"
                PointerPressed="SplitterHandle_PointerPressed"
                PointerMoved="SplitterHandle_PointerMoved"
                PointerReleased="SplitterHandle_PointerReleased" />

            <!-- Detail panel -->
            <Border Grid.Column="2" Margin="0,0,12,0" Padding="20" CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <ScrollViewer>
                    <StackPanel x:Name="DetailPanel" Spacing="12">
                        <TextBlock Text="Mod 详情" Style="{StaticResource SectionHeaderStyle}" />
                        <TextBlock x:Name="DetailName" FontSize="18" FontWeight="Bold" />
                        <TextBlock x:Name="DetailType" Opacity="0.7" />
                        <TextBlock x:Name="DetailStatus" />
                        <TextBlock x:Name="DetailDescription" TextWrapping="Wrap" />
                        <TextBlock x:Name="DetailPath" TextWrapping="Wrap" FontSize="12" Opacity="0.6" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="OpenFolderButton" Content="打开目录" Click="OpenFolderButton_Click" />
                            <Button x:Name="UninstallButton" Content="卸载" Click="UninstallButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>