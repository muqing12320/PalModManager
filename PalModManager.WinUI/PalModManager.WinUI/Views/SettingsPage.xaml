<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="PalModManager.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Spacing="24" MaxWidth="800" HorizontalAlignment="Left">
            <InfoBar x:Name="PageInfoBar" IsOpen="False" IsClosable="True" />
            <TextBlock Text="设置与框架" Style="{StaticResource SectionHeaderStyle}" />

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="游戏路径" FontWeight="SemiBold" />
                    <TextBox x:Name="GamePathTextBox" IsReadOnly="True" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="BrowseGamePathButton" Content="浏览..." Click="BrowseGamePathButton_Click" />
                        <Button x:Name="DetectGamePathButton" Content="自动检测" Click="DetectGamePathButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="服务器路径" FontWeight="SemiBold" />
                    <TextBox x:Name="ServerPathTextBox" IsReadOnly="True" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="BrowseServerPathButton" Content="浏览..." Click="BrowseServerPathButton_Click" />
                        <Button x:Name="DetectServerPathButton" Content="自动检测" Click="DetectServerPathButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="FrameworkHeader" Text="框架状态" FontWeight="SemiBold" />
                    <TextBlock x:Name="FrameworkStatusText" Text="未检测" />
                    <Button x:Name="InstallFrameworksButton" Content="一键安装 UE4SS + PalSchema" Click="InstallFrameworksButton_Click" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="同步" FontWeight="SemiBold" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="SyncToServerButton" Content="客户端 → 服务器" Click="SyncToServerButton_Click" />
                        <Button x:Name="SyncToClientButton" Content="服务器 → 客户端" Click="SyncToClientButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="外观" FontWeight="SemiBold" />
                    <ToggleSwitch x:Name="ThemeToggle" Header="深色主题" Toggled="ThemeToggle_Toggled" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
