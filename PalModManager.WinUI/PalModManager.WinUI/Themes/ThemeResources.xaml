<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PalModManager.WinUI.Views">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#E5E7EB" />
            <SolidColorBrush x:Key="BrandAccentBrush" Color="#0969DA" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#1A7F37" />
            <SolidColorBrush x:Key="WarningBrush" Color="#9A6700" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#CF222E" />
            <SolidColorBrush x:Key="ClientModeBrush" Color="#7C3AED" />
            <SolidColorBrush x:Key="ServerModeBrush" Color="#0E7490" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#0D1830" />
            <SolidColorBrush x:Key="BrandAccentBrush" Color="#48C9C5" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#3FB950" />
            <SolidColorBrush x:Key="WarningBrush" Color="#D29922" />
            <SolidColorBrush x:Key="ErrorBrush" Color="#F85149" />
            <SolidColorBrush x:Key="ClientModeBrush" Color="#A78BFA" />
            <SolidColorBrush x:Key="ServerModeBrush" Color="#48C9C5" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <Style x:Key="SuccessTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource SuccessBrush}" />
    </Style>

    <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource ErrorBrush}" />
    </Style>

    <Style x:Key="ClientModeDotStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource ClientModeBrush}" />
    </Style>

    <Style x:Key="ServerModeDotStyle" TargetType="Ellipse">
        <Setter Property="Fill" Value="{ThemeResource ServerModeBrush}" />
    </Style>

    <local:ModStatusToBoolConverter x:Key="ModStatusToBoolConverter" />

</ResourceDictionary>
