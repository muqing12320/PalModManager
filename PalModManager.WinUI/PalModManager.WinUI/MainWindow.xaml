<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="PalModManager.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="帕鲁Mod管理器">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid Grid.Row="0" Height="90" Padding="22,40,22,0" Background="{ThemeResource TopBarBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="PALWORLD" FontSize="18" FontWeight="ExtraBold" CharacterSpacing="100" />
                <TextBlock Text="MOD MANAGER" FontSize="18" FontWeight="SemiBold" Opacity="0.7" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="UpdateStatusText" Text="" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
                <Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdateButton_Click" />
                <Button
                    x:Name="ModeButton"
                    Click="ModeButton_Click"
                    ToolTipService.ToolTip="点击切换客户端/服务器模式">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse
                            x:Name="ModeDot"
                            Width="10"
                            Height="10"
                            Style="{StaticResource ClientModeDotStyle}"
                            VerticalAlignment="Center" />
                        <TextBlock x:Name="ModeLabelText" Text="客户端" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Navigation + content -->
        <NavigationView
            Grid.Row="1"
            x:Name="NavView"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            OpenPaneLength="200"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="ModsNavItem" Content="Mod 管理" Tag="ModsPage">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="设置与框架" Tag="SettingsPage">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Setting" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Frame x:Name="ContentFrame" Margin="24" />
        </NavigationView>
    </Grid>
</Window>
